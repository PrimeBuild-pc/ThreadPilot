<UserControl x:Class="ThreadPilot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThreadPilot.Views"
             xmlns:models="clr-namespace:ThreadPilot.Models"
             xmlns:converters="clr-namespace:ThreadPilot.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- One setting = one row: what it is on the left, its control on the right (Windows 11 Settings). -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SubSettingRowStyle" TargetType="Border" BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="Margin" Value="32,0,0,4"/>
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="{DynamicResource SettingsView_Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource SettingsView_Subtitle}"
                       Style="{StaticResource PageSubtitleTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,12,12">

                <!-- General -->
                <TextBlock Text="{DynamicResource SettingsView_BasicPreferences}" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,8"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.AutostartWithWindows}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_StartWithWindows}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_StartWithWindows}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_AutostartDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="200"
                                  SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag"
                                  AutomationProperties.Name="{DynamicResource SettingsView_Language}">
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageEnUs}" Tag="en-US"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageZhCn}" Tag="zh-CN"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageItIt}" Tag="it-IT"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageFrFr}" Tag="fr-FR"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageDeDe}" Tag="de-DE"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageEsEs}" Tag="es-ES"/>
                            <ComboBoxItem Content="{DynamicResource SettingsView_LanguageRuRu}" Tag="ru-RU"/>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_Language}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_LanguageDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.UseDarkTheme}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_UseDarkTheme}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_UseDarkTheme}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_ThemeDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.ClearMasksOnClose}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_ResetProcessChangesOnExit}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_ResetProcessChangesOnExit}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_ResetProcessChangesOnExitDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableSelfLowImpactMode}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_LowImpactMode}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_LowImpactMode}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_LowImpactDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Rules & automation -->
                <TextBlock Text="{DynamicResource SettingsView_RulesAutomation}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.ApplyPersistentRulesOnProcessStart}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_RuleAutoApply}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_ApplyOnStart}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource SettingsView_ApplyOnStartDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableWmiMonitoring}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_EnableWmi}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_EnableWmi}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_WmiDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableFallbackPolling}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_EnableFallback}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_EnableFallback}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_FallbackDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Slider Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.PollingIntervalMs}"
                                    Minimum="1000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="{DynamicResource SettingsView_PollingInterval}"/>
                            <TextBlock Text="{Binding Settings.PollingIntervalMs}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SettingsView_PollingInterval}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding Settings.EnableFallbackPolling}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Slider Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.FallbackPollingIntervalMs}"
                                    Minimum="5000" Maximum="60000" TickFrequency="5000" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="{DynamicResource SettingsView_FallbackPollingInterval}"/>
                            <TextBlock Text="{Binding Settings.FallbackPollingIntervalMs}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SettingsView_FallbackPollingInterval}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>

                <!-- CPU assignment -->
                <TextBlock Text="{DynamicResource SettingsView_CpuAssignment}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="200"
                                  SelectedValue="{Binding Settings.DefaultCpuAssignmentMode}"
                                  SelectedValuePath="Tag"
                                  ToolTip="{DynamicResource SettingsView_CpuAssignmentTooltip}"
                                  AutomationProperties.Name="{DynamicResource SettingsView_DefaultCpuAssignment}"
                                  AutomationProperties.HelpText="{DynamicResource SettingsView_CpuAssignmentTooltip}">
                            <ComboBoxItem Content="{DynamicResource CpuAssignmentMode_AffinityMask}" Tag="{x:Static models:CpuAssignmentMode.AffinityMask}" ToolTip="{DynamicResource CpuAssignmentMode_AffinityMaskTooltip}"/>
                            <ComboBoxItem Content="{DynamicResource CpuAssignmentMode_IdealProcessor}" Tag="{x:Static models:CpuAssignmentMode.IdealProcessor}" ToolTip="{DynamicResource CpuAssignmentMode_IdealProcessorTooltip}"/>
                            <ComboBoxItem Content="{DynamicResource CpuAssignmentMode_CpuSets}" Tag="{x:Static models:CpuAssignmentMode.CpuSets}" ToolTip="{DynamicResource CpuAssignmentMode_CpuSetsTooltip}"/>
                            <ComboBoxItem Content="{DynamicResource CpuAssignmentMode_Automatic}" Tag="{x:Static models:CpuAssignmentMode.Automatic}" ToolTip="{DynamicResource CpuAssignmentMode_AutomaticTooltip}"/>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_DefaultCpuAssignment}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_CpuAssignmentDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReservedCpuSetsStatus}" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource SettingsView_ReservedCpuSetsWarning}"
                                   Style="{StaticResource DescriptionStyle}"
                                   ToolTip="{DynamicResource SettingsView_ReservedCpuSetsTooltip}"
                                   AutomationProperties.HelpText="{DynamicResource SettingsView_ReservedCpuSetsTooltip}"/>
                    </StackPanel>
                </Border>

                <!-- System tray -->
                <TextBlock Text="{DynamicResource SettingsView_SystemTray}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.ShowTrayIcon}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_ShowTrayIcon}"/>
                        <TextBlock Text="{DynamicResource SettingsView_ShowTrayIcon}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.MinimizeToTray}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_MinimizeToTray}"/>
                        <TextBlock Text="{DynamicResource SettingsView_MinimizeToTray}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.CloseToTray}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_CloseToTray}"/>
                        <TextBlock Text="{DynamicResource SettingsView_CloseToTray}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableQuickApplyFromTray}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_QuickApply}"/>
                        <TextBlock Text="{DynamicResource SettingsView_QuickApply}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableMonitoringControlFromTray}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_MonitoringControl}"/>
                        <TextBlock Text="{DynamicResource SettingsView_MonitoringControl}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.ShowDetailedTooltips}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_DetailedTooltips}"/>
                        <TextBlock Text="{DynamicResource SettingsView_DetailedTooltips}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.StartMinimized}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_StartMinimized}"/>
                        <TextBlock Text="{DynamicResource SettingsView_StartMinimized}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>

                <!-- Notifications -->
                <TextBlock Text="{DynamicResource SettingsView_Notifications}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableNotifications}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_EnableNotifications}"/>
                        <TextBlock Text="{DynamicResource SettingsView_EnableNotifications}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <StackPanel IsEnabled="{Binding Settings.EnableNotifications}">
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="200"
                                      SelectedValue="{Binding Settings.NotificationLevel}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{DynamicResource SettingsView_NotificationLevel}">
                                <ComboBoxItem Content="{DynamicResource SettingsView_NotificationLevelAll}" Tag="{x:Static models:NotificationLevelProfile.All}"/>
                                <ComboBoxItem Content="{DynamicResource SettingsView_NotificationLevelWarningsErrors}" Tag="{x:Static models:NotificationLevelProfile.WarningsAndErrorsOnly}"/>
                                <ComboBoxItem Content="{DynamicResource SettingsView_NotificationLevelSilent}" Tag="{x:Static models:NotificationLevelProfile.Silent}"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource SettingsView_NotificationLevel}" Style="{StaticResource SettingTitleStyle}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                             IsChecked="{Binding Settings.EnableToastNotifications}"
                                             AutomationProperties.Name="{DynamicResource SettingsView_EnableToast}"/>
                            <TextBlock Text="{DynamicResource SettingsView_EnableToast}" Style="{StaticResource SettingTitleStyle}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                             IsChecked="{Binding Settings.EnableBalloonNotifications}"
                                             AutomationProperties.Name="{DynamicResource SettingsView_EnableBalloon}"/>
                            <TextBlock Text="{DynamicResource SettingsView_EnableBalloon}" Style="{StaticResource SettingTitleStyle}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_NotificationTypes}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <CheckBox Content="{DynamicResource SettingsView_NotifyPowerPlan}" IsChecked="{Binding Settings.EnablePowerPlanChangeNotifications}" Margin="0,0,24,4"/>
                                <CheckBox Content="{DynamicResource SettingsView_NotifyProcess}" IsChecked="{Binding Settings.EnableProcessMonitoringNotifications}" Margin="0,0,24,4"/>
                                <CheckBox Content="{DynamicResource SettingsView_NotifyError}" IsChecked="{Binding Settings.EnableErrorNotifications}" Margin="0,0,24,4"/>
                                <CheckBox Content="{DynamicResource SettingsView_NotifySuccess}" IsChecked="{Binding Settings.EnableSuccessNotifications}" Margin="0,0,24,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Slider Width="200" VerticalAlignment="Center"
                                        Value="{Binding Settings.NotificationDisplayDurationMs}"
                                        Minimum="1000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="{DynamicResource SettingsView_Duration}"/>
                                <TextBlock Text="{Binding Settings.NotificationDisplayDurationMs}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_Duration}" Style="{StaticResource SettingTitleStyle}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SubSettingRowStyle}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Content="{DynamicResource SettingsView_TestNotification}"
                                    Command="{Binding TestNotificationCommand}"/>
                            <TextBlock/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Advanced -->
                <TextBlock Text="{DynamicResource SettingsView_Advanced}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableNotificationHistory}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_NotificationHistory}"/>
                        <TextBlock Text="{DynamicResource SettingsView_NotificationHistory}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SubSettingRowStyle}" IsEnabled="{Binding Settings.EnableNotificationHistory}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Slider Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.MaxNotificationHistoryItems}"
                                    Minimum="10" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="{DynamicResource SettingsView_MaxHistory}"/>
                            <TextBlock Text="{Binding Settings.MaxNotificationHistoryItems}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SettingsView_MaxHistory}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.AutoHideNotifications}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_AutoHide}"/>
                        <TextBlock Text="{DynamicResource SettingsView_AutoHide}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableNotificationSound}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_NotificationSound}"/>
                        <TextBlock Text="{DynamicResource SettingsView_NotificationSound}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableDebugLogging}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_DebugLogging}"/>
                        <TextBlock Text="{DynamicResource SettingsView_DebugLogging}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnablePerformanceCounters}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_PerformanceCounters}"/>
                        <TextBlock Text="{DynamicResource SettingsView_PerformanceCounters}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>

                <!-- Updates and about -->
                <TextBlock Text="{DynamicResource SettingsView_About}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button Content="{DynamicResource SettingsView_CheckUpdates}" Command="{Binding CheckUpdatesCommand}"/>
                            <ui:Button Appearance="Primary" Margin="8,0,0,0"
                                       Content="{DynamicResource SettingsView_DownloadInstallUpdate}"
                                       Command="{Binding DownloadAndInstallUpdateCommand}"
                                       IsEnabled="{Binding CanDownloadAndInstallUpdate}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitleStyle}">
                                <Run Text="{DynamicResource SettingsView_ThreadPilot}" FontWeight="SemiBold"/>
                                <Run Text="{Binding ApplicationVersion, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource DescriptionStyle}">
                                <Run Text="{DynamicResource SettingsView_LatestVersion}"/>
                                <Run Text="{Binding LatestUpdateVersion, Mode=OneWay}"/>
                                <Run Text="·"/>
                                <Run Text="{DynamicResource SettingsView_LastUpdateCheck}"/>
                                <Run Text="{Binding LastUpdateCheckText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.EnableAutomaticUpdateChecks}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_EnableAutomaticUpdateChecks}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsView_EnableAutomaticUpdateChecks}" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsView_UpdatesDescription}" Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.IncludePrereleaseUpdates}"
                                         AutomationProperties.Name="{DynamicResource SettingsView_IncludePrereleaseUpdates}"/>
                        <TextBlock Text="{DynamicResource SettingsView_IncludePrereleaseUpdates}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>

                <!-- Help -->
                <TextBlock Text="{DynamicResource SettingsView_SomethingWrong}" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding OpenDiscordCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17" Margin="0,0,7,0">
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
