                <Border Style="{StaticResource SettingRowStyle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ReportIssueCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Bug24" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource SettingsView_ReportIssue}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource SettingsView_IssuesDescription}" Style="{StaticResource SettingTitleStyle}"/>
                    </DockPanel>
                </Border>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource DescriptionStyle}">
                    <Run Text="{DynamicResource SettingsView_Copyright}"/>
                    <Run Text="·"/>
                    <Run Text="{DynamicResource SettingsView_License}"/>
