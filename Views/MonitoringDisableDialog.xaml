<Window x:Class="ThreadPilot.Views.MonitoringDisableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disable Automation Monitoring"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource CardSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource StandardCardCornerRadius}"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{DynamicResource MonitoringDisableDialog_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource MonitoringDisableDialog_Message}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource MonitoringDisableDialog_Impact}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningTextBrush}"
                       Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource MonitoringDisableDialog_Cancel}"
                        Click="Cancel_Click"
                        Padding="16,8"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource MonitoringDisableDialog_Confirm}"
                        Click="Confirm_Click"
                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                        Padding="16,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
